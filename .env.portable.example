# Portable Windows profile.
# You can copy this file to .env manually, but the portable-start scripts generate
# stronger passwords and secrets automatically.

WEB_PORT=3200
DATABASE_URL=file:./runtime/data/scaner.db

AUTH_SECRET=generate-a-64-char-random-secret
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=admin@scaner.local
ADMIN_PASSWORD=generate-a-long-unique-password

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=.instagram/session.json
INSTAGRAM_PROXY_URL=

VK_ACCESS_TOKEN=
YOUTUBE_API_KEY=

COLLECTION_CRON=0 3 * * *
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=15000
SOCIAL_KNOWN_PROFILE_SKIP_LIMIT=5000
SOCIAL_PLATFORM_CONCURRENCY_INSTAGRAM=1
SOCIAL_PLATFORM_CONCURRENCY_VK=1
SOCIAL_PLATFORM_CONCURRENCY_YOUTUBE=1
NEXT_PUBLIC_APP_NAME=ScanerBlogers
